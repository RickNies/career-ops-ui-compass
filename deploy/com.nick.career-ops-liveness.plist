<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nick.career-ops-liveness</string>
  <!-- Daily at 06:30 (staggered 30m before the 07:00 scan). Probes every
       tracker URL for dead/closed listings; annotate-only into
       data/liveness.tsv. The Compass UI hides rows marked dead. -->
  <key>EnvironmentVariables</key>
  <dict><key>CAREER_OPS_ROOT</key><string>/Users/nick/apps/career-ops</string></dict>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/nick/apps/career-ops-scrape/venv/bin/python</string>
    <string>/Users/nick/apps/career-ops-scrape/liveness.py</string>
    <string>sweep</string>
    <string>--concurrency</string><string>10</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/career-ops-liveness.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/career-ops-liveness.err.log</string>
</dict>
</plist>
