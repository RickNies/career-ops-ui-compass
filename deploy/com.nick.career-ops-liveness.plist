<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nick.career-ops-liveness</string>
  <!-- Daily 06:30 (staggered 30m before the 07:00 scan). Two-tier: HTTP
       prefilter (liveness.py) then Camoufox browser-verify (liveness_browser.py)
       to catch JS soft-404s. Annotate-only -> data/liveness.tsv; UI hides dead. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/nick/apps/career-ops-scrape/run-liveness.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/tmp/career-ops-liveness.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/career-ops-liveness.err.log</string>
</dict>
</plist>
